{
  "expo": {
    "name": "NAP-IQ",
    "slug": "usernamei",
    "scheme": "napiq",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1F3A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.napiq.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "NAP-IQ uses your device's current location to verify your installation address when you apply for service."
      }
    },
    "android": {
      "package": "com.napiq.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0B1F3A"
      },
      "config": {
        "googleMaps": {
          "apiKey": "REPLACE_WITH_YOUR_ANDROID_GOOGLE_MAPS_API_KEY"
        }
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2E7DFF"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "NAP-IQ uses your photo library so you can attach a completion photo to a job.",
          "cameraPermission": "NAP-IQ uses your camera so you can take a completion photo for a job."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "NAP-IQ uses your device's current location to verify your installation address when you apply for service."
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://napiq-production.up.railway.app",
      "eas": {
        "projectId": "b62aa4b3-fdc4-4bc3-959c-cd58d86c9b62"
      }
    },
    "owner": "usernameis-team"
  }
}